# Configure secrets only in the backend runtime; never place these in VITE_ variables.
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional background queue; real publishing integrations are NOT configured.
REDIS_URL=
# Production requires durable database volume or database migration.
APP_URL=

# Persistent volume-backed SQLite file for a single backend instance
DATABASE_PATH=./data/proppost.db
BOOTSTRAP_AGENCY_NAME=Initial Agency
# Development ONLY; never use in production
SEED_DEMO_DATA=false
